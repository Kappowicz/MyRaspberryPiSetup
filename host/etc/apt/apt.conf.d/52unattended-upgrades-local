// Local configuration. 50unattended-upgrades stays untouched so that a package
// upgrade never asks about a conffile conflict - hence the number 52 (APT reads
// the directory alphabetically, the later file wins) and the explicit #clear,
// because lists in APT are APPENDED to by default, not replaced.

// By default Debian also enables the "label=Debian" line here, covering the
// whole stable repository - every update, not just security ones.
// Narrow it down to security only.
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename},label=Debian-Security";
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};

// This Pi is the DNS server for the whole house. An automatic reboot is a
// minute without internet at a random moment and a "what happened?" nobody
// can answer. Rebooting stays a human decision.
Unattended-Upgrade::Automatic-Reboot "false";

// Old kernels stay. With 412 GB free, being able to fall back to the previous
// kernel is worth more than the reclaimed space.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "false";
Unattended-Upgrade::Remove-New-Unused-Dependencies "false";

// There is no mail on this machine, so the report goes to the journal - which
// has been persistent since 2026-08-29, so "it stopped working on Tuesday" can
// be matched against what was upgraded then.
Unattended-Upgrade::SyslogEnable "true";
