[Unit]
Description=Telegraf System Metrics Collector
After=influxdb.service
Requires=influxdb.service
PartOf=influxdb.service

[Container]
ContainerName=telegraf
Image=docker.io/library/telegraf:latest@sha256:a08d378c99c31c1e0b463a57d4926932515e37c08417d7e5376653f26dc9eadd

# Pinned digest; updates are deliberate via tools/update-images.py.

# Network=host allows monitoring physical eth0/wlan0 and communicating with InfluxDB on localhost:8086
Network=host

# Mounts host filesystems to collect host metrics instead of container metrics
Volume=%h/telegraf/telegraf.conf:/etc/telegraf/telegraf.conf:ro,Z
Volume=%h/telegraf/scripts:/etc/telegraf/scripts:ro,Z
Volume=/proc:/host/proc:ro
Volume=/sys:/host/sys:ro
Volume=/:/hostfs:ro
# Mask /home inside /hostfs so Telegraf cannot read ~/.config/secrets, ~/.ssh,
# or ~/backups while still keeping /hostfs statfs("/") and udev metadata intact.
# (Tmpfs= cannot be nested inside a read-only bind mount in crun.)
Volume=/mnt:/hostfs/home:ro

AddDevice=/dev/vcio_gencmd:/dev/vcio_gencmd
GroupAdd=keep-groups

Environment=HOST_PROC=/host/proc
Environment=HOST_SYS=/host/sys
Environment=HOST_MOUNT_PREFIX=/hostfs
EnvironmentFile=%h/.config/secrets/influx-telegraf.env

# Explicit entrypoint bypasses setpriv drop which fails in rootless Podman
Entrypoint=/usr/bin/telegraf
Exec=--config /etc/telegraf/telegraf.conf
RunInit=yes

[Service]
MemoryHigh=256M
MemoryMax=384M
SuccessExitStatus=143
Restart=always
RestartSec=5

[Install]
WantedBy=default.target influxdb.service
