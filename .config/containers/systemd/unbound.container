[Unit]
Description=unbound jako posrednik DoT dla Pi-hole
After=network-online.target

[Container]
Image=docker.io/klutchell/unbound:latest

# Marks this container for `podman auto-update`. The label alone changes
# nothing on its own: podman-auto-update.timer is MASKED (see README), so
# no scheduled job ever pulls or restarts anything. What reads the label is
# image-check.timer, which runs `podman auto-update --dry-run` weekly and
# only sends a notification. Updating stays a manual, chosen act:
#   podman auto-update            # pulls AND restarts - run it when you want
#                                 # the restart, not when the timer says so
AutoUpdate=registry
ContainerName=unbound
Network=host
Volume=%h/unbound/unbound.conf:/etc/unbound/unbound.conf:ro,Z
# The image daemonises by default and the container then exits with code 0.
Exec=-d -c /etc/unbound/unbound.conf

[Service]

# Pi-hole kieruje tu CALY ruch wychodzacy, wiec smierc tego kontenera oznacza
# brak rozwiazywania nazw w calym domu. Czyste wyjscie tez ma konczyc sie
# restartem - z tego samego powodu co przy samym Pi-hole.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
