[Unit]
Description=unbound as the DoT forwarder for Pi-hole
After=network-online.target

[Container]
Image=docker.io/klutchell/unbound:latest@sha256:78726b893001147c6e3404ebee7245ccb68dbfd97c43b191b9221809182c3834

# Pinned digest; updates are deliberate via tools/update-images.py.
ContainerName=unbound
Network=host
Volume=%h/unbound/unbound.conf:/etc/unbound/unbound.conf:ro,Z
# The image daemonises by default and the container then exits with code 0.
Exec=-d -c /etc/unbound/unbound.conf

[Service]
MemoryHigh=128M
MemoryMax=256M

# Pi-hole sends ALL outgoing queries here, so this container dying means no
# name resolution for the whole house. A clean exit must end in a restart
# too - for the same reason as with Pi-hole itself.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
