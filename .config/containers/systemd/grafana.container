[Container]
Image=docker.io/grafana/grafana:latest@sha256:ac461fb352abc50da10a51c7d02462e9c05488f11f53f14b3ad79a8145f638a0

# Pinned digest; updates are deliberate via tools/update-images.py.
Network=sensor-net.network
Volume=grafana-data:/var/lib/grafana:Z
Volume=%h/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Volume=%h/grafana/dashboards:/var/lib/grafana/dashboards:ro,Z
PublishPort=3000:3000
# Attached to the same network so Grafana can see the InfluxDB database
EnvironmentFile=%h/.config/secrets/grafana.env
# Org and bucket for the provisioned datasource ($__env{} in provisioning).
Environment=INFLUXDB_SYSTEM_BUCKET=system_metrics
EnvironmentFile=%h/.config/site.conf

[Service]
Restart=always

[Install]
WantedBy=default.target
