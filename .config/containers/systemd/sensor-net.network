[Network]
# Creates an isolated network named systemd-sensor-net

# Upstream resolver for aardvark-dns, pinned instead of inherited.
#
# With no DNS= here aardvark reads its upstreams from the host
# /etc/resolv.conf. NetworkManager keeps the router RA nameserver
# fe80::...%eth0 in that file, and resolving the %eth0 scope id fails inside
# the rootless network namespace. aardvark then discards the WHOLE upstream
# list, including the working IPv4 one, and logs:
#
#   failed to get upstream nameservers, dns forwarding will not work:
#   resolve scope id: IO error: No such device (os error 19)
#
# It only reads resolv.conf at startup and on reload, so the breakage lands
# whenever a container on this network is restarted - a Grafana restart on
# 2026-09-01 16:16 silently cut city-air off from api.gios.gov.pl for 30 h
# while container-to-container names kept resolving.
#
# Do NOT put the LAN address (192.168.0.57) here. pasta runs the rootless
# netns with --config-net, which copies the host address AND the interface
# name into that namespace: inside it 192.168.0.57/24 sits on a local eth0,
# so aardvark queries to it land on lo, where nothing listens, and every
# lookup fails with "dns request got empty response". This is the same trap
# the 2026-08-29 note in city-air.container describes.
#
# Do NOT use 169.254.1.2 either - that was the 2026-09-03 fix and it lasted
# only until the next reboot. It is the pasta --map-guest-addr address, and
# pasta(1) is explicit about what that means: packets to it are redirected
# "to the address assigned to the guest with -a, or by default the host's
# global address". So it reaches Pi-hole only while pasta actually HAS the
# host global address - and on a cold boot it often does not. On 2026-09-03
# network-online.target fired at 21:05:54 with only lo up,
# podman-user-wait-network-online.service was satisfied 10 ms later, influxdb
# started at 21:05:55 and brought pasta up with it - while eth0 only got link
# and its DHCP lease at 21:05:59.8, four seconds too late. With no global
# address to copy, pasta fell back to a link-local tap0 (169.254.2.1/16),
# every lookup to 169.254.1.2 was redirected there, nothing listened, and
# city-air lost the GIOS station for 17 h. pasta configures this once, at
# netns creation, so a lease arriving seconds later never repairs it.
#
# 169.254.1.1 is the pasta --dns-forward address. pasta answers on it ITSELF
# and forwards to the host resolvers, so it does not depend on which address
# pasta managed to give the namespace - it kept resolving correctly all the
# way through the outage above, which is what makes it the reboot-safe
# choice. The queries still land on Pi-hole on the host, so blocking and DoT
# stay in the path. Unlike aardvark, pasta handles the fe80::...%eth0 entry
# in the host resolv.conf without discarding the rest of the list.
#
# Both are podman 5.x defaults - re-check them if podman or pasta is replaced.
DNS=169.254.1.1
