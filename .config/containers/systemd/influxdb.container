[Container]
Image=docker.io/influxdb:2@sha256:05d6fb735bc22449c401094d42846123a24e3325d3a6e092242a45bfd68fff21

# Pinned digest; updates are deliberate via tools/update-images.py.
Network=sensor-net.network
Volume=influxdb-data:/var/lib/influxdb2:Z
PublishPort=127.0.0.1:8086:8086
Environment=INFLUXD_REPORTING_DISABLED=true

[Service]
Restart=always

[Install]
WantedBy=default.target
