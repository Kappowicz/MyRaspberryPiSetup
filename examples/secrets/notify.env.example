# Template. Copy to ~/.config/secrets/notify.env and fill in your own topics.
# NOTE: the ntfy topic name is the only thing protecting the channel.
# Anyone who knows it can read and post. Generate randomly: openssl rand -hex 8
NTFY_ALARM=https://ntfy.sh/malinka-alarm-RANDOM_STRING_HERE
NTFY_INFO=https://ntfy.sh/malinka-info-RANDOM_STRING_HERE
