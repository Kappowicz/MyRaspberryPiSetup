# An ALLOWLIST, not a denylist.
#
# A denylist fails OPEN: some day you add a file with a secret in it, forget to
# list it here, and it goes into the repository - and git remembers forever.
# An allowlist fails CLOSED: the worst case is that something is missing and
# you notice.
#
# Pattern for a directory: !dir/  then  dir/*  then  !dir/what-we-want
# (git cannot be talked into a file whose directory is excluded).

*

!.gitignore
!README.md
!LICENSE
!install.sh
!.githooks/
!.githooks/*

!healthcheck.sh
!backup.sh
!notify.sh
!rebuild-images.sh

!alerts/
alerts/*
!alerts/*.sh
!alerts/*.py

# grafana/ and examples/ use the same strict dir/* + !dir/what-we-want pattern
# as everything else, so a file dropped in later is NOT committed by accident.
!grafana/
grafana/*
!grafana/dashboards/
grafana/dashboards/*
# The dashboard is a TEMPLATE: install.sh renders the .json from it using the
# labels in ~/.config/site.conf. The rendered .json stays out of the repository.
!grafana/dashboards/*.json.in
!grafana/provisioning/
grafana/provisioning/*
!grafana/provisioning/dashboards/
grafana/provisioning/dashboards/*
!grafana/provisioning/dashboards/*.yaml
!grafana/provisioning/datasources/
grafana/provisioning/datasources/*
!grafana/provisioning/datasources/*.yaml

!examples/
examples/*
!examples/*.example
!examples/secrets/
examples/secrets/*
!examples/secrets/*.example

!.config/
.config/*
!.config/alerts.conf

!.config/containers/
.config/containers/*
!.config/containers/systemd/
.config/containers/systemd/*
!.config/containers/systemd/*.container
!.config/containers/systemd/*.network

!.config/systemd/
.config/systemd/*
!.config/systemd/user/
.config/systemd/user/*
!.config/systemd/user/*.service
!.config/systemd/user/*.timer
!.config/systemd/user/*.service.d/
!.config/systemd/user/*.service.d/*.conf

# The secrets store has no place here in any form - the .config/* rule above
# already excludes it. Templates live separately, under examples/, so that
# ~/.config/secrets is governed by one simple rule: git does not go in there.
#
# ~/.config/site.conf is excluded by the same rule. It holds the only values
# tied to one house - org, bucket, GIOS station, location tags, DHCP suffix -
# and its template is examples/site.conf.example.

!sensor-app/
sensor-app/*
!sensor-app/*.py
!sensor-app/*.txt
!sensor-app/*.sh
!sensor-app/Containerfile

!city-app/
city-app/*
!city-app/*.py
!city-app/*.txt
!city-app/*.sh
!city-app/Containerfile


!unbound/
unbound/*
!unbound/*.conf

# Generated bytecode never belongs in a repository.
__pycache__/
*.pyc

!telegraf/
telegraf/*
!telegraf/*.conf
!telegraf/scripts/
telegraf/scripts/*
!telegraf/scripts/*.sh

!grafana/dashboards/system-metrics.json

# Reproducible recovery scripts and reviewed host defaults.
!RECOVERY.md
!host/
host/*
!host/setup-host.sh
!host/etc/
host/etc/*
!host/etc/sysctl.d/
!host/etc/sysctl.d/*.conf
!host/etc/systemd/
host/etc/systemd/*
!host/etc/systemd/system/
!host/etc/systemd/system/*.service
!host/etc/systemd/system.conf.d/
!host/etc/systemd/system.conf.d/*.conf
!host/etc/udev/
host/etc/udev/*
!host/etc/udev/rules.d/
!host/etc/udev/rules.d/*.rules
!host/usr/
host/usr/*
!host/usr/local/
host/usr/local/*
!host/usr/local/sbin/
!host/usr/local/sbin/*.sh
!tools/
!tools/*.py
!tests/
!tests/*.py
!pihole/
pihole/*
!pihole/load-rules.sh
!macbook/
macbook/*
!macbook/*.sh
!macbook/*.example
!macbook/README.md
*.backup-*
*.partial

!host/etc/systemd/journald.conf.d/
!host/etc/systemd/journald.conf.d/*.conf
!host/etc/systemd/system/sysstat-collect.timer.d/
!host/etc/systemd/system/sysstat-collect.timer.d/*.conf
!host/etc/apt/
host/etc/apt/*
!host/etc/apt/apt.conf.d/
!host/etc/apt/apt.conf.d/52unattended-upgrades-local
!host/etc/default/
!host/etc/default/sysstat
!host/etc/sysstat/
!host/etc/sysstat/sysstat
!host/etc/smartd.conf
!host/etc/modprobe.d/
!host/etc/modprobe.d/disable-sound.conf
!nucleo-bridge.py
!.config/systemd/user/nucleo-bridge.service
