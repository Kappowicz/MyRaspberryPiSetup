        {
          "query": "from(bucket: \"system_metrics\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"net\" and r[\"interface\"] == \"eth0\" and (r[\"_field\"] == \"bytes_recv\" or r[\"_field\"] == \"bytes_sent\")) |> derivative(unit: 1s, nonNegative: true) |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
