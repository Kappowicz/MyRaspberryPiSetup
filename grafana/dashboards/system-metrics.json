        "graphMode": "area"
      },
      "targets": [
        {
          "query": "from(bucket: \"system_metrics\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"cpu\" and r[\"cpu\"] == \"cpu-total\" and r[\"_field\"] == \"usage_idle\") |> map(fn: (r) => ({r with _value: 100.0 - r._value})) |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
